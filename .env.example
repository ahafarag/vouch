# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# AI: set ONE of these. Claude is used if both are present.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Sandbox personal accounts used by "Load demo contract"
# (developer.paypal.com > Testing Tools > Sandbox Accounts)
DEMO_CLIENT_EMAIL=
DEMO_FREELANCER_EMAIL=

# Optional: where the SQLite file lives (defaults to ./data/vouch.db)
# DATABASE_PATH=/var/data/vouch.db
